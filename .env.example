# Configure these variables in Netlify > Site configuration > Environment variables
PETIOT_DEVICE_TOKEN=replace_with_a_long_random_device_secret
PETIOT_WEB_PIN=replace_with_your_private_dashboard_pin

# Arduino sends to:
# Host: petiot.netlify.app
# Path: /api/telemetry
# Authorization: Bearer <PETIOT_DEVICE_TOKEN>
